# =========================
# Application
# =========================
APP_NAME=Smart Bill Operation
NODE_ENV=development
HTTP_PORT=8080
TIME_ZONE=Asia/Ho_Chi_Minh
FILE_FOLDER=uploads
# Public base URL of this API (used to build attachment URLs)
PUBLIC_URL=http://localhost:8080
# Comma separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=10

# =========================
# Database (PostgreSQL)
# =========================
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USERNAME=sbo
DATABASE_PASSWORD=change-me
DATABASE_NAME=sbo
DATABASE_DEBUG=false
# true auto-creates/updates tables (convenient in dev). Use migrations and set false in production.
DATABASE_SYNCHRONIZE=true

# =========================
# Security (generate long random values: openssl rand -base64 48)
# =========================
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRATION=1d
# Encrypts the Telegram bot token and Gemini API key stored in the database
APP_SECRET_KEY=replace-with-another-long-random-string

# =========================
# First admin account (created only when the users table is empty)
# =========================
DEFAULT_ADMIN_EMAIL=admin@sbo.local
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_NAME=Quản trị viên
